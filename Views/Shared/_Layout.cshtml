<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    @await Html.PartialAsync("_HeaderPartial")
    <style>
        /* Sayfa düzeni için flexbox */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        /* İçerik alanı */
        .content {
            flex: 1; /* Sayfa içeriği alanını genişletir */
        }

        /* Footer düzeni */
        footer {
            /* background-color: ; */
            color: white;
            padding: 20px 0;
            text-align: center;
        }

        /* Footer içindeki logo alanı */
        .footer-logo {
            display: flex;
            justify-content: center; /* Yatayda ortalar */
            align-items: center; /* Dikeyde ortalar */
        }

        /* Footer içindeki logo resmi */
        .footer-img {
            max-width: 100%; /* Görselin genişliği */
            display: block; /* Ortalamayı destekler */
            margin: auto; /* Otomatik merkezleme */
        }

        /* Custom Modal için body scroll kontrolü */
        body.modal-open {
            overflow: hidden !important;
        }

        /* Custom Modal için body scroll kontrolü - Tarifler sayfası */
        body.custom-modal-open {
            overflow: hidden !important;
        }

        /* WhatsApp Floating Button */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 20px;
            right: 20px;
            background-color: #25d366;
            color: #FFF;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
        }

        .whatsapp-float:hover {
            background-color: #20ba5a;
            transform: scale(1.05);
        }

        .whatsapp-float:active {
            transform: scale(0.98);
        }

        .whatsapp-float i {
            margin-top: 0;
            color: #FFF;
        }

        /* Mobil için WhatsApp butonu */
        @@media (max-width: 768px) {
            .whatsapp-float {
                width: 55px;
                height: 55px;
                bottom: 15px;
                right: 15px;
                font-size: 28px;
            }
        }

        /* Çok küçük ekranlar için */
        @@media (max-width: 480px) {
            .whatsapp-float {
                width: 50px;
                height: 50px;
                bottom: 10px;
                right: 10px;
                font-size: 24px;
            }
        }
    </style>

</head>
<body>
    <!-- Navbar -->
    @await Html.PartialAsync("_NavbarPartial")

    <!-- Sayfa İçeriği -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- Footer -->
    @await Html.PartialAsync("_FooterPartial")

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/905336352458" 
       class="whatsapp-float" 
       target="_blank" 
       rel="noopener noreferrer" 
       aria-label="WhatsApp ile iletişime geçin"
       title="WhatsApp ile iletişime geçin">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script src="~/js/jquery-3.5.1.min.js?v=2.0"></script>
    <script src="~/js/bootstrap.min.js?v=2.0"></script>
    <script src="~/js/all.min.js?v=2.0"></script>
    <script src="~/js/theme.js?v=2.0"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
