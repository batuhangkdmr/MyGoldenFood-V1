    }

    .seo-content-wrapper h2 {
        font-size: 1.8rem;
        font-weight: 600;
        color: #ffc107;
        margin-top: 40px;
        margin-bottom: 20px;
        border-left: 4px solid #ffc107;
        padding-left: 15px;
    }

    .seo-content-wrapper h3 {
        font-size: 1.4rem;
        font-weight: 600;
