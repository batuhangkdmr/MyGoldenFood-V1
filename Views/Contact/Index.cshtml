@{
    ViewData["Title"] = "Bize Ulaşın | My Golden Food - İletişim";
}

<!-- SEO Meta Etiketleri -->
<head>
    <meta name="description" content="My Golden Food ile iletişime geçin. Dondurulmuş gıda ürünleri hakkında bilgi almak için bizimle iletişime geçin.">
    <meta name="keywords" content="İletişim, My Golden Food, Dondurulmuş Gıda, Müşteri Hizmetleri, Ankara">
    <meta name="author" content="My Golden Food">
    <link rel="canonical" href="https://mygoldenfood.com/Contact/Index" />
</head>

<!-- Schema Markup (Google SEO için) -->
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "ContactPage",
        "name": "Bize Ulaşın - My Golden Food",
        "description": "My Golden Food ile iletişime geçin. Dondurulmuş gıda ürünleri hakkında bilgi almak için bizimle iletişime geçin.",
        "url": "https://mygoldenfood.com/Contact/Index",
        "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+90 533 635 24 58",
            "contactType": "Customer Service",
            "email": "gokhangokdemir@mygoldenfood.com",
            "areaServed": "TR",
            "availableLanguage": ["Türkçe", "English"]
        }
    }
</script>

<!-- İletişim Sayfası İçeriği -->
<div class="container mt-5">
    <h1 class="text-center">Bize Ulaşın</h1> <!-- SEO İçin H1 Güncellendi -->
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form id="contactForm">
                <div class="mb-3">
                    <label for="name" class="form-label">Adınız11</label>
                    <input type="text" class="form-control" id="name" name="name" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">E-Posta Adresiniz</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">Mesajınız</label>
                    <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100" aria-label="Gönder Butonu">Gönder</button>
            </form>
        </div>
    </div>
</div>
